{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && ../dev-env.sh cargo run"],
      "port": 8080
    },
    {
      "name": "api-pg",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && DATABASE_URL=\"${DATABASE_URL:-postgres://localhost/grace_ride_dev}\" DEV_MODE=true ../dev-env.sh cargo run"
      ],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}

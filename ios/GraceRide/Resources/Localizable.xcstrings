    "studio_step1_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight soft clay shapes paired with twelve colours from dark ink to warm cream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供 8 种立体泥塑造型，搭配从墨黑到奶油白共 12 种质感配色。"
          }
        }
      }
    },
    "studio_step1_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "01 · Pick a shape and colour"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "01 · 选择形状与色彩"
          }
        }
      }
    },
    "studio_step2_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sixteen expressive faces track your touch in 3D, plus fifteen animations in the Move tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "16 款灵动表情会随手指触摸立体转动视线，还可在「动作」页体验 15 种互动动画。"
          }
        }
      }
    },
    "studio_step2_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "02 · Choose an expression & motion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "02 · 挑选表情与动作"
          }
        }
      }
    },
    "studio_step3_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set directly as your Grace Ride avatar, save a 512x512 transparent PNG or vector SVG, or copy a link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键保存为恩典同行个人头像，也可导出 512x512 透明 PNG、独立 SVG 矢量图，或复制专属链接。"
          }
        }
      }
    },
    "studio_step3_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "03 · Save or export"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "03 · 设为头像或导出分享"
          }
        }
      }
    },
    "studio_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a shape, a colour, and a face to build your own Grok bot avatar. Preview how it moves, save it to your profile, or export PNG and SVG."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由搭配形状、颜色与表情，打造专属的 Grok 机器人头像。可预览全部动态效果、一键设为个人头像，或导出透明 PNG 与矢量 SVG。"
          }
        }
      }
    },
    "studio_surprise_me": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surprise me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机惊喜"
          }
        }
      }
    },
    "studio_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok bot avatar maker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok 机器人头像工坊"
          }
        }
      }
    },
    "terms_accept_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick the box only after you have read these terms. We record the time and the version you agree to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先阅读这些条款，再亲自勾选。我们会记录你同意的时间和版本。"
          }
        }
      }
    },
    "terms_accept_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How you opt in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何选择加入"
          }
        }
      }
    },
    "terms_agree": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意并继续"
          }
        }
      }
    },
    "terms_changes_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When these terms change in a way that matters, the version number changes and you are asked to opt in again before you continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当条款有重要变更时，版本号会更新，你需要再次选择加入才能继续使用。"
          }
        }
      }
    },
    "terms_changes_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes to these terms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条款变更"
          }
        }
      }
    },
    "terms_conduct_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use other members’ details only to arrange the ride you share. Do not copy, share or misuse them. Be respectful in chats. Do not upload anything unlawful or anything you have no right to share. Admins may suspend an account that breaks these terms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他会员的资料只可用来安排你们共同的接送，不可复制、转发或滥用。在聊天中互相尊重。不要上传违法内容或你无权分享的内容。违反条款的账号，管理员可以暂停。"
          }
        }
      }
    },
    "terms_conduct_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the app properly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "妥善使用"
          }
        }
      }
    },
    "terms_controller_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PJ State CMC decides how this app uses your personal data and is responsible for it. Send any question, request or complaint about your data to the church office or to an admin in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PJ State CMC 决定本应用如何使用你的个人资料，并为此负责。关于你资料的任何疑问、要求或投诉，请联络教会办公室或应用内的管理员。"
          }
        }
      }
    },
    "terms_controller_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is responsible for your data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁负责你的资料"
          }
        }
      }
    },
    "terms_drivers_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drivers are volunteers using their own cars. They must hold a valid licence, road tax and insurance, and drive safely. Riders pay no fare; any cost sharing only covers fuel and tolls at rates the church sets. Wear a seat belt and follow the driver’s safety directions. The church arranges rides in good faith but cannot guarantee any ride."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "司机是使用自己车辆的义工，必须持有有效驾照、路税和保险，并安全驾驶。乘客不付车资；任何费用分摊只涵盖教会订定的油费和过路费。请系好安全带，并遵从司机的安全指示。教会本着善意安排接送，但不能保证每一趟接送。"
          }
        }
      }
    },
    "terms_drivers_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drivers and riding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "司机与乘车"
          }
        }
      }
    },
    "terms_external_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in, invite and account recovery pages may use Cloudflare Turnstile to block automated abuse; Cloudflare processes technical browser/device signals under its privacy policy and may operate outside Malaysia. If you opt in to alerts: web push notifications travel through your browser’s push provider (such as Google FCM, Apple, Mozilla, Microsoft or Samsung); on the web app you may also opt in to Telegram bot alerts (for alert messages only, never location) or WhatsApp/church alert webhooks when enabled by the church office. The iOS app uses real-time event streams, background notification refresh and optional Apple Push Notification service (APNs) alerts, Apple Keychain credential storage, local offline cache and WidgetKit home-screen snapshots on your device (all cleared on sign-out). Passkey sign-in uses WebAuthn / Apple AuthenticationServices (biometrics stay on your device). Optional iOS QR check-in scanning uses the system AVFoundation camera scanner (manual code entry is always available). Optional EventKit calendar exports, private calendar feeds (.ics), phone dialling and share sheets open only when you choose them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登入、邀请注册和账号找回页面可能使用 Cloudflare Turnstile 防止恶意自动化攻击；Cloudflare 会依其隐私政策处理浏览器与设备技术信号，服务器可能位于马来西亚境外。若你选择开启提醒：网页推送通知会经由你所用浏览器的推送服务商（如 Google FCM、Apple、Mozilla、Microsoft 或 Samsung）送达；在网页端，如教会后台已启用，你也可选择开启 Telegram 机器人提醒（仅用于文字通知，绝不用于位置共享）或 WhatsApp / 教会提醒 Webhook。iOS 应用使用实时事件流、后台通知刷新与可选的 Apple 推送通知（APNs）、Apple Keychain 凭据存储、本地离线缓存及桌面 WidgetKit 小组件快照（登出时均会清除）。通行密钥登入使用 WebAuthn / Apple AuthenticationServices（生物识别资料仅保留在你的设备中）。iOS 端可选的二维码扫码签到使用系统相机扫码（随时也可手动输入签到码）。导出到苹果日历（EventKit）、订阅私人日历连结（.ics）、拨打电话及系统分享功能仅在你主动点击时触发。"
          }
        }
      }
    },
    "terms_external_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications, security and other services"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知、安全与其他服务"
          }
        }
      }
    },
    "terms_info_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name, email and phone, and a photo or avatar you add. Saved pickup addresses (and optional map pins), ride times, event sign-ups and check-ins, and trip chat messages. For volunteer drivers: vehicle details (model, colour, plate), spare seats and service areas. If you book for family or cell members (proxy riders): their name, phone, pickup address and optional assistance notes — only add them with their permission. If you claim or share costs: payee details and receipt or transfer photos. Your notification preferences, plus sign-in and change logs for security."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的姓名、电邮、电话，以及你自行添加的照片或头像。常用上车地址（及可选地图坐标）、接送时间、活动报名与签到记录，以及行程聊天讯息。若你是志愿司机：车辆资料（车型、颜色、车牌）、可载座位数和服务区域。若你代家人或组员预约（代订乘车人）：他们的姓名、电话、上车地址及可选协助备注——请先征得对方同意再填写。若你申请报销或分摊费用：你提供的收款人资料以及收据或转账截图。你的通知偏好，以及用于安全保障的登入与修改记录。"
          }
        }
      }
    },
    "terms_info_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information we collect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们收集的资料"
          }
        }
      }
    },
    "terms_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grace Ride (恩典同行) is a private ride-coordination app for PJ State CMC. It is not a public taxi or e-hailing service. You must opt in yourself. The box is never ticked for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恩典同行（Grace Ride）是 PJ State CMC 的内部接送协调应用，不是公开的召车或电召车服务。你必须亲自选择加入。勾选框不会预先勾上。"
          }
        }
      }
    },
    "terms_location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pickup address and area are shown to the assigned driver and the transport team once a ride is arranged. You may optionally tap “Use my current location” when saving a pickup address to attach a one-time GPS map pin for driver routing. Live location is shared strictly during an active, in-progress journey: drivers may share live GPS so passengers on that trip can see arrival times (on iOS, via CoreLocation live trip sharing only while actively assigned—never tracking in the background outside an active trip—which stops automatically when the trip ends, is cancelled, or your session locks or signs out); passengers may optionally share a waiting-spot pin while the driver is on the way, which is deleted once picked up. All live driver and passenger coordinates are deleted as soon as the trip ends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接送安排好之后，上车地址和区域会显示给获派的司机和交通组。保存常用地址时，你也可以自行点击“使用当前定位”附加一次性的 GPS 坐标，方便司机规划路线。实时位置仅在“进行中”的行程期间共享：司机可开启实时位置让同程乘客查看预计到达时间（在 iOS 应用中通过 CoreLocation 仅在活跃行程期间共享位置，绝不会在非行程期间追踪，并在行程完成、取消、会话锁定或登出时自动停止）；乘客也可在司机前往途中选择性共享候车位置，上车后即自动删除。所有司机与乘客的实时坐标均会在行程结束时立即删除。"
          }
        }
      }
    },
    "terms_location_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rides and location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接送与位置"
          }
        }
      }
    },
    "terms_logout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登出"
          }
        }
      }
    },
    "terms_opt_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read these terms and the privacy notice, and I opt in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读这些条款和隐私声明，并选择加入"
          }
        }
      }
    },
    "terms_ownership_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Grace Ride software and its design are protected by copyright and licensed to PJ State CMC. Do not copy, modify or redistribute them. The church’s name and logo belong to the church. Photos and messages you add stay yours; you allow the church to show them in the app for its ride work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grace Ride 软件及其设计受版权保护，授权给 PJ State CMC 使用。请勿复制、修改或转发。教会的名称和标志属于教会。你加上的照片和讯息仍属于你；你允许教会为接送事工在应用内显示它们。"
          }
        }
      }
    },
    "terms_ownership_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copyright"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版权"
          }
        }
      }
    },
    "terms_purpose_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To identify you, approve your membership, match riders with drivers, contact you about a ride you are part of, share costs fairly, keep the app secure, and report attendance and transport to church leaders. We do not sell your data or use it for advertising."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来识别你、批准会籍、配对乘客与司机、就你参与的接送联络你、公平分摊费用、维护应用安全，以及向教会领袖报告出席和交通情况。我们不会出售你的资料，也不会用于广告。"
          }
        }
      }
    },
    "terms_purpose_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why we use it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们为何使用"
          }
        }
      }
    },
    "terms_retention_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live location: until the trip ends (or until picked up for a passenger waiting pin). Geocoded address cache: up to 30 days (1 day for failed lookups). Alert delivery logs: 30 days. Unreferenced uploads: 24 hours. Trip chats: 180 days by default. Read notifications: 90 days; unread: one year. Security logs: two years by default. Backups: 30 days. Your profile, saved addresses, vehicles and ride history are kept while your account is open and for as long as church records require after it is closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时位置：保存到行程结束（乘客候车位置于上车后即删除）。地址地理编码缓存：最多 30 天（未匹配记录 1 天）。外部通知发送记录：30 天。未被引用的上传文件：24 小时。行程聊天：默认 180 天。已读通知：90 天；未读通知：一年。安全记录：默认两年。备份：30 天。个人资料、常用地址、车辆资料和接送记录在账号有效期间保存；账号关闭后，按教会记录所需期限保存。"
          }
        }
      }
    },
    "terms_retention_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long we keep it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料保存多久"
          }
        }
      }
    },
    "terms_rights_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can update your profile at any time. You can ask to see a copy of your data, correct it, receive it in a common format, or close your account. You can withdraw your consent, but you then cannot use the app. If you are not satisfied, you may complain to the Personal Data Protection Commissioner (JPDP)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时更新个人资料。你可以要求查看你的资料副本、更正资料、以通用格式取得资料，或关闭账号。你可以撤回同意，但之后就不能使用本应用。若你不满意，可以向个人资料保护专员（JPDP）投诉。"
          }
        }
      }
    },
    "terms_rights_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rights"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的权利"
          }
        }
      }
    },
    "terms_see_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no public member directory. A driver or passenger sees a phone number only for a ride they share, after that ride is approved. If you create and share an optional Care Link for a ride, anyone with that link can view that trip’s status, driver/vehicle summary and live driver location/ETA only while the trip is active, until you revoke it or the trip ends. Admins, the transport team and the finance team see only the records they need for their work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有公开的会员通讯录。司机或乘客只在共同的接送获批准后，才能看到该次接送的电话。若你为某趟接送生成并分享可选的“关怀连结”，持有该连结的家属或关怀者仅在行程有效期间可查看该趟进度、司机/车辆摘要及司机实时位置与预计到达时间，直至你撤销连结或行程结束。管理员、交通组和财务组只查看工作所需的记录。"
          }
        }
      }
    },
    "terms_see_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can see your details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁能看到你的资料"
          }
        }
      }
    },
    "terms_sensitive_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using this app shows that you take part in a church, and a ride may note a wheelchair, oxygen or other assistance need. The law treats religious belief and health as sensitive. By opting in you give your explicit consent for us to use this only to arrange your rides. Leave the assistance field empty if you prefer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本应用会显示你参与教会；接送也可能注明轮椅、氧气或其他协助需要。法律把宗教信仰和健康资料列为敏感资料。你选择加入，即明确同意我们只为安排接送而使用这些资料。若不愿提供，协助一栏可以留空。"
          }
        }
      }
    },
    "terms_sensitive_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive information"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感资料"
          }
        }
      }
    },
    "terms_service_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app helps invited members arrange rides to church activities. An admin sends a link. You enter your own name and email. An admin later assigns your role and group. Until that approval, you can use your profile and nothing else."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用帮助受邀会员安排教会活动的接送。管理员发出连结。你自己填写姓名和电邮。管理员之后才分配职务与群体。在批准之前，你只能使用个人资料。"
          }
        }
      }
    },
    "terms_service_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这项服务"
          }
        }
      }
    },
    "terms_third_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find addresses, estimate arrival times and plan pickup order, the app sends addresses and map coordinates (never your name) to free OpenStreetMap services: Nominatim, OSRM and Photon. Your device may also load map tiles from OpenStreetMap. These servers may be outside Malaysia. Map data © OpenStreetMap contributors. When you tap Navigate or Open in Maps, the destination address or coordinates are handed off to your chosen external maps app (such as Google Maps, Waze or your device’s default maps app), which is governed by that provider’s own terms and privacy policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了查找地址、估算到达时间与规划接送顺序，应用会把地址和地图坐标（不含你的姓名）发送到免费的 OpenStreetMap 服务：Nominatim、OSRM 和 Photon；你的设备也可能从 OpenStreetMap 载入地图图块。这些服务器可能位于马来西亚境外。地图资料 © OpenStreetMap 贡献者。当你点击“导航”或“在地图中打开”时，目的地地址或坐标会交由你选择的外部地图应用（如 Google Maps、Waze 或系统默认地图）处理，并受该服务商自身的条款与隐私政策约束。"
          }
        }
      }
    },
    "terms_third_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps, routing and navigation services"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图、路线规划与导航服务"
          }
        }
      }
    },
    "terms_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of use and privacy notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用条款与隐私声明"
          }
        }
      }
    },
    "terms_updated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 3 · Effective 25 November 2026"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 3 版 · 2026 年 11 月 25 日起生效"
          }
        }
      }
    },
    "terms_who_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the app only with a link that was sent to you. Do not share your invite link or passkey. One person, one account. A parent or guardian must opt in for anyone under 18."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只使用发给你的连结。不要把邀请连结或通行密钥交给别人。一人一个账号。未满 18 岁者须由父母或监护人代为同意。"
          }
        }
      }
    },
    "terms_who_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who may join"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁可以使用"
          }
        }
      }
    },
    "today": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "tomorrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天"
          }
        }
      }
    },
    "unlock_backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用代码"
          }
        }
      }
    },
    "unlock_code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6-digit code"
          }
        },
        "zh-Hans": {

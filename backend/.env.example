# Copy to .env and adjust.
# DEV_MODE=true loads demo members (password GraceRide2026!) and treats password logins as 2FA-verified.
# NEVER enable DEV_MODE in production.
DEV_MODE=true
DATABASE_URL=postgres://localhost/grace_ride_dev
UPLOAD_DIR=./data/uploads
# The URL members open in their browser. Passkeys are bound to this host.
PUBLIC_URL=http://localhost:5173
BIND=127.0.0.1:8080
MAX_LIVE_DRIVERS=10
# Production: serve the built frontend from the API server
# STATIC_DIR=../frontend/dist
# Production first run: the first administrator's email (a one-time setup link is printed to the log)
# ADMIN_EMAIL=admin@pjstatecmc.org
RUST_LOG=grace_ride=info,tower_http=info

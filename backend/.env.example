# Copy to .env and adjust.
# DEV_MODE=true loads demo members (password GraceRide2026!) and treats password logins as 2FA-verified.
# NEVER enable DEV_MODE in production.
DEV_MODE=true
# 64-hex-char (32-byte) key used to envelope-encrypt TOTP secrets and app_secrets in Postgres (required outside dev/local HTTP).
SECRETS_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
DATABASE_URL=postgres://localhost/grace_ride_dev
# Integration test database (each test creates its own isolated schema inside this DB).
# TEST_DATABASE_URL=postgres://localhost/grace_ride_test
UPLOAD_DIR=./data/uploads
# The URL members open in their browser. Passkeys are bound to this host.
PUBLIC_URL=http://localhost:5173
BIND=127.0.0.1:8080
MAX_LIVE_DRIVERS=10
# Trust the first X-Forwarded-For hop for client IPs (enable only behind your own reverse proxy).
TRUST_PROXY=false
# Time zone every stored time is local to (IANA name). Set it once, before real data:
# changing it later does not convert times already stored.
APP_TIMEZONE=Asia/Kuala_Lumpur
# Database pool. Keep DB_MAX_CONNECTIONS under Postgres max_connections.
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
# Longest a single query may run (0 = no limit). Migrations are not limited.
DB_STATEMENT_TIMEOUT_SECS=15
# Data retention, session inactivity auto-lock (0 = disabled), and housekeeping cadence.
CHAT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=730
SESSION_TIMEOUT_MINS=15
HOUSEKEEPING_INTERVAL_MINS=60
NOTIFICATION_RETENTION_DAYS=90
# Log format: "text" (default) or "json" (structured JSON for log shippers).
LOG_FORMAT=text
# Optional comma-separated allowlist override for Web Push endpoint hosts (e.g. fcm.googleapis.com,.push.apple.com).
# PUSH_ALLOWED_HOSTS=
# Pickup routing (best pickup order + ETAs). Uses free OpenStreetMap services by default:
# pickup addresses are sent to Nominatim for geocoding. ROUTING_ENABLED=false keeps them
# in-house (straight-line estimates from shared GPS only). Self-host with the URLs below.
# ROUTING_ENABLED=true
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Address autocomplete while members type (Nominatim's policy forbids search-as-you-type).
# PHOTON_URL=https://photon.komoot.io
# GEOCODER_USER_AGENT=GraceRide/0.1
# GEOCODER_COUNTRY=my
# Production: serve the built frontend from the API server
# STATIC_DIR=../frontend/dist
# Production first run: the first administrator's email (a one-time setup link is printed to the log)
# ADMIN_EMAIL=admin@pjstatecmc.org
RUST_LOG=grace_ride=info,tower_http=info
# Sentry error monitoring DSN (leave blank or omit to disable).
# Never set this to a DSN that receives personal data (names, phones, addresses).
# SENTRY_DSN=
# Optional Cloudflare Turnstile human verification on public web auth/onboarding/visitor flows.
# Leave both blank to disable. For local DEV_MODE=true testing you may use Cloudflare's dummy keys:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Optional Google OAuth 2.0 sign-in, account verification & password reset (redirect URI: <PUBLIC_URL>/api/auth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# Optional comma-separated SHA-256 signing certificate fingerprints (AA:BB:...) for
# native Android passkey origin verification (android:apk-key-hash:...) and /.well-known/assetlinks.json.
# ANDROID_CERT_SHA256_FINGERPRINTS=
# Optional comma-separated Apple App IDs (<TEAM_ID>.<BUNDLE_ID>) for iOS Universal Links
# and native passkey Associated Domains (/.well-known/apple-app-site-association).
# IOS_APP_IDS=

  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/third-party-licenses.mjs",
    "build": "tsc -b && vite build",

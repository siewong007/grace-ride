# Frontend environment variables for Vite.
# Copy to .env.local and fill in values for local development.
# VITE_* variables are embedded in the browser bundle — never put secrets here.

# Sentry error monitoring DSN (leave blank or omit to disable).
# Never set this to a DSN that receives personal data (names, phones, addresses).
# VITE_SENTRY_DSN=

# App version shown in diagnostics (usually injected from package.json at build time).
# VITE_APP_VERSION=0.1.0

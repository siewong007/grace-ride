            android:action="android.intent.action.VIEW"
            android:data="graceride://open/rides"
            android:targetPackage="org.pjstatecm.graceride"
            android:targetClass="org.pjstatecm.graceride.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="events"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_monochrome"
        android:shortcutShortLabel="@string/shortcut_events_short"
        android:shortcutLongLabel="@string/shortcut_events_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="graceride://open/events"
            android:targetPackage="org.pjstatecm.graceride"
            android:targetClass="org.pjstatecm.graceride.MainActivity" />

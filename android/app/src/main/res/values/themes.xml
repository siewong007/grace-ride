<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GraceRide" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:filterTouchesWhenObscured">true</item>
    </style>
    <style name="Theme.GraceRide.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.GraceRide</item>
    </style>
</resources>

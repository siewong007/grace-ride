root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml,sql,py}]
indent_style = space
indent_size = 4

[{Makefile,Caddyfile,*Caddyfile}]
indent_style = tab

[*.{ts,tsx,js,mjs,json,yml,yaml,css,html,sh}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

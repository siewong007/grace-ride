# --- Required ---
DOMAIN=ride.pjstatecmc.org
ACME_EMAIL=it@pjstatecmc.org
PUBLIC_URL=https://ride.pjstatecmc.org
ADMIN_EMAIL=admin@pjstatecmc.org
POSTGRES_PASSWORD=change-me-strong
# First administrator (a one-time setup link is printed in the app log on first start:
#   docker compose logs app | grep "one-time link")

# --- Safe defaults (already set in the image) ---
DEV_MODE=false
TRUST_PROXY=true
LOG_FORMAT=json
# Generate with: openssl rand -hex 32 (required outside local dev/tests to encrypt TOTP secrets & app_secrets)
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
MAX_LIVE_DRIVERS=10
# Default organization idle auto-lock timeout in minutes (0 = disabled; editable in /admin/settings).
SESSION_TIMEOUT_MINS=15
# Pickup routing (best pickup order + ETAs). Uses free OpenStreetMap services by default:
# pickup addresses are sent to Nominatim for geocoding. ROUTING_ENABLED=false keeps them
# in-house (straight-line estimates from shared GPS only). Self-host with the URLs below
# (see deploy/docker-compose.osrm.yml + scripts/setup_osrm_malaysia.sh).
# ROUTING_ENABLED=true
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Address autocomplete while members type (Nominatim's policy forbids search-as-you-type).
# PHOTON_URL=https://photon.komoot.io
# GEOCODER_USER_AGENT=GraceRide/0.1 (+https://ride.pjstatecmc.org)
# GEOCODER_COUNTRY=my
# Optional comma-separated host or `.suffix` allowlist override for Web Push subscription endpoints
# (defaults to standard Apple, Google FCM, Mozilla, and Windows push hosts).
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,.push.apple.com,.push.services.mozilla.com,.notify.windows.com
CHAT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=730
# Time zone every stored time is local to (IANA name). Set it once, before real data:
# changing it later does not convert times already stored.
APP_TIMEZONE=Asia/Kuala_Lumpur
# Database pool. Keep DB_MAX_CONNECTIONS under Postgres max_connections.
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
# Longest a single query may run (0 = no limit). Migrations are not limited.
DB_STATEMENT_TIMEOUT_SECS=15
# Clean-up cadence and notification retention (read ones; unread are kept a year).
HOUSEKEEPING_INTERVAL_MINS=60
NOTIFICATION_RETENTION_DAYS=90
RUST_LOG=grace_ride=info,tower_http=warn

# --- Optional Cloudflare Turnstile (human verification on public web auth/invite/visitor flows) ---
# Must use real production keys from Cloudflare Turnstile (dummy test keys are rejected outside localhost).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Backup encryption (scripts/backup.sh — required in production) ---
REQUIRE_ENCRYPTION=true
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_GPG_RECIPIENT=ops@pjstatecmc.org
# Optional native attestation / Associated Domains configuration:
# ANDROID_CERT_SHA256_FINGERPRINTS=
# IOS_APP_IDS=<TEAM_ID>.org.pjstatecm.graceride
# REQUIRE_BIOMETRIC_ATTESTATION=false

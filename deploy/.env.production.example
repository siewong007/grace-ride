# --- Required ---
DOMAIN=ride.pjstatecmc.org
ACME_EMAIL=it@pjstatecmc.org
PUBLIC_URL=https://ride.pjstatecmc.org
# First administrator (a one-time setup link is printed in the app log on first start:
#   docker compose logs app | grep "one-time link")
ADMIN_EMAIL=admin@pjstatecmc.org

# --- Safe defaults (already set in the image) ---
DEV_MODE=false
TRUST_PROXY=true
LOG_FORMAT=json
MAX_LIVE_DRIVERS=10
CHAT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=730
RUST_LOG=grace_ride=info,tower_http=warn

# --- Optional: litestream backup (docker compose --profile backup up -d) ---
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

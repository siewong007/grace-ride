# --- Required ---
DOMAIN=ride.pjstatecmc.org
ACME_EMAIL=it@pjstatecmc.org
PUBLIC_URL=https://ride.pjstatecmc.org
ADMIN_EMAIL=admin@pjstatecmc.org
POSTGRES_PASSWORD=change-me-strong
# First administrator (a one-time setup link is printed in the app log on first start:
#   docker compose logs app | grep "one-time link")

# --- Safe defaults (already set in the image) ---
DEV_MODE=false
TRUST_PROXY=true
LOG_FORMAT=json
MAX_LIVE_DRIVERS=10
# Pickup routing (best pickup order + ETAs). Uses free OpenStreetMap services by default:
# pickup addresses are sent to Nominatim for geocoding. ROUTING_ENABLED=false keeps them
# in-house (straight-line estimates from shared GPS only). Self-host with the URLs below.
# ROUTING_ENABLED=true
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Address autocomplete while members type (Nominatim's policy forbids search-as-you-type).
# PHOTON_URL=https://photon.komoot.io
# GEOCODER_USER_AGENT=GraceRide/0.1
# GEOCODER_COUNTRY=my
CHAT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=730
RUST_LOG=grace_ride=info,tower_http=warn

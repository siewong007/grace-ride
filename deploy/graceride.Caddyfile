# One process serves the API and the SPA. Replace X-Forwarded-For so the
# app's first-hop trust sees the visitor Caddy already resolved
# (global trusted_proxies + Cf-Connecting-Ip), not a client-supplied chain.
# Host Caddy MUST also configure global servers { trusted_proxies static <Cloudflare CIDRs>; client_ip_headers Cf-Connecting-Ip }.
graceride.saliminn.my {
	# Cloudflare SSL/TLS mode MUST be set to "Full (strict)".
	# Install the 15-year Cloudflare Origin CA certificate and key (0640 root:caddy):
	#   /etc/caddy/certs/graceride-origin.pem
	#   /etc/caddy/certs/graceride-origin.key
	# Optional mTLS defense-in-depth (enable "Authenticated Origin Pulls" in Cloudflare first):
	#   tls {$ORIGIN_CERT:/etc/caddy/certs/graceride-origin.pem} {$ORIGIN_KEY:/etc/caddy/certs/graceride-origin.key} {
	#       client_auth {
	#           mode require_and_verify
	#           trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
	#       }
	#   }
	tls {$ORIGIN_CERT:/etc/caddy/certs/graceride-origin.pem} {$ORIGIN_KEY:/etc/caddy/certs/graceride-origin.key}
	# Recommended when host Caddy has Cloudflare Origin Pull CA provisioned:
	#   client_auth {
	#       mode require_and_verify
	#       trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
	#   }
	# Server-sent events (/api/stream) must not be buffered or compressed.
	@notsse not path /api/stream
	encode @notsse zstd gzip
	header -Server
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1
		header_up X-Forwarded-For {client_ip}
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				request>headers>Referer delete
				request>uri regexp "((?:/api)?/(?:invites?|visit|care)/|/api/(?:calendar|push/telegram/webhook)/|[?&]code=)[^/?&#]+" "${1}[REDACTED]"
			}
		}
	}
}

{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

{$DOMAIN} {
	# Server-sent events (/api/stream) must not be buffered or compressed.
	@notsse not path /api/stream
	encode @notsse zstd gzip
	# The app sets its own security headers (CSP, HSTS, …); hide server banners.
	header -Server
	request_body {
		max_size 12MB
	}
	reverse_proxy app:8080 {
		flush_interval -1
		# Overwrite any client-supplied X-Forwarded-For with the direct peer IP so TRUST_PROXY=true is safe.
		header_up X-Forwarded-For {client_ip}
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				request>headers>Referer delete
				request>uri regexp "((?:/api)?/(?:invites?|visit|care)/|/api/(?:calendar|push/telegram/webhook)/|[?&]code=)[^/?&#]+" "${1}[REDACTED]"
			}
		}
	}
}

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# The app sets its own security headers (CSP, HSTS, …); hide server banners.
	header -Server
	request_body {
		max_size 12MB
	}
	reverse_proxy app:8080 {
		# Caddy replaces any client-supplied X-Forwarded-For, so TRUST_PROXY=true is safe here.
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format json
	}
}
